rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isPlatformAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isChatAdmin(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return signedIn() && (
        request.auth.uid == chat.participants[0] ||
        (chat.admins != null && request.auth.uid in chat.admins)
      );
    }

    function isSelfJoiningChat() {
      return signedIn() &&
        resource.data.type in ["community", "project"] &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["participants"]) &&
        request.resource.data.participants.hasAll(resource.data.participants) &&
        request.auth.uid in request.resource.data.participants &&
        !(request.auth.uid in resource.data.participants);
    }

    function isPostOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function currentUserName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }

    function isFriendLinkWrite(userId) {
      return signedIn() &&
        request.auth.uid != userId &&
        resource.data != null &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["friends", "chats"]) &&
        request.resource.data.friends is list &&
        (
          (
            request.resource.data.friends.hasAll(resource.data.friends) &&
            currentUserName() in request.resource.data.friends
          ) ||
          (
            resource.data.friends.hasAll(request.resource.data.friends) &&
            currentUserName() in resource.data.friends
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(["chats"]) ||
          request.resource.data.chats is list
        );
    }

    function validPostCreate() {
      return signedIn() &&
        request.resource.data.userId is string &&
        request.resource.data.userName is string &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        request.resource.data.interests is list &&
        (request.resource.data.userId == request.auth.uid || isPlatformAdmin());
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == userId || isPlatformAdmin() || isFriendLinkWrite(userId));
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.status == "pending";

      allow read: if signedIn();

      allow update, delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isPlatformAdmin());
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId) || isPlatformAdmin();
      allow create: if signedIn();
      allow update: if isChatParticipant(chatId) || isPlatformAdmin() || isSelfJoiningChat();
      allow delete: if isChatParticipant(chatId) || isPlatformAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (isChatParticipant(resource.data.chatId) || isPlatformAdmin());
      allow create: if signedIn() && (isChatParticipant(request.resource.data.chatId) || isPlatformAdmin());
      allow update, delete: if signedIn() && (isChatParticipant(resource.data.chatId) || isPlatformAdmin());
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validPostCreate();
      allow update, delete: if isPostOwner() || isPlatformAdmin();
    }

    // Key history stays server-only via Admin SDK API routes.
    match /chatEncryptionKeys/{chatId} {
      allow read, write: if false;
    }

    // Broadcasts are admin-managed from backend/admin pages.
    match /adminBroadcasts/{broadcastId} {
      allow read: if signedIn();
      allow write: if signedIn() && isPlatformAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
